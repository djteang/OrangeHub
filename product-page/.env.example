# GitHub repository in owner/name format.
VITE_GITHUB_REPO=djteang/OrangeHub

# Optional direct Windows installer URL. If omitted, the page uses GitHub Releases/latest/download.
VITE_WINDOWS_DOWNLOAD_URL=https://github.com/djteang/OrangeHub/releases/latest/download/OrangeHub-Setup.exe

# Optional direct Windows portable executable URL. If omitted, the page uses GitHub Releases/latest/download.
VITE_WINDOWS_PORTABLE_DOWNLOAD_URL=https://github.com/djteang/OrangeHub/releases/latest/download/OrangeHub-Portable.exe

# Optional author contact override.
VITE_AUTHOR_EMAIL=hello@czdgg.top
