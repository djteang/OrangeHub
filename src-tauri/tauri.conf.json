{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrangeHub",
  "version": "0.1.9",
  "identifier": "com.orangehub.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFQTQwOThGQjA5MDU3MjgKUldRb1Y1Q3dqd21rTHNOalFKM082TVNIUEtyYjRqbGFkL0ZPZG0wb1dJQno1dmhrYVVBZXptRFQK",
      "endpoints": [
        "https://github.com/djteang/OrangeHub/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "OrangeHub",
        "width": 1200,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": false,
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "installer-template.nsi",
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "category": "DeveloperTool",
    "licenseFile": "../LICENSE.txt",
    "shortDescription": "Remote & database client",
    "longDescription": "OrangeHub - unified SSH/SFTP/FTP terminal and multi-database client"
  }
}
