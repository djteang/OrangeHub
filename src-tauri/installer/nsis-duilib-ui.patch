+class AppImageControl final : public DuiLib::CControlUI {
+ public:
+  [[nodiscard]] LPCTSTR GetClass() const override {
+    return L"AppImageUI";
+  }
+
+  void SetAttribute(LPCTSTR name, LPCTSTR value) override {
+    if (_wcsicmp(name, L"source") == 0 && value != nullptr) {
+      image_.reset(Gdiplus::Image::FromFile(value, TRUE));
+    } else {
+      CControlUI::SetAttribute(name, value);
+    }
+  }
+
+  bool DoPaint(HDC dc,
+               const RECT& paint,
+               DuiLib::CControlUI* stop_control) override {
+    if (!CControlUI::DoPaint(dc, paint, stop_control)) {
+      return false;
+    }
+    if (!image_ || image_->GetLastStatus() != Gdiplus::Ok) {
+      return true;
+    }
+
+    const RECT bounds = GetPos();
+    const Gdiplus::REAL width =
+        static_cast<Gdiplus::REAL>(bounds.right - bounds.left);
+    const Gdiplus::REAL height =
+        static_cast<Gdiplus::REAL>(bounds.bottom - bounds.top);
+    const Gdiplus::REAL scale = (std::min)(
+        width / static_cast<Gdiplus::REAL>(image_->GetWidth()),
+        height / static_cast<Gdiplus::REAL>(image_->GetHeight()));
+    const Gdiplus::REAL draw_width = image_->GetWidth() * scale;
+    const Gdiplus::REAL draw_height = image_->GetHeight() * scale;
+    const Gdiplus::REAL left = bounds.left + (width - draw_width) / 2.0F;
+    const Gdiplus::REAL top = bounds.top + (height - draw_height) / 2.0F;
+
+    Gdiplus::Graphics graphics(dc);
+    graphics.SetInterpolationMode(Gdiplus::InterpolationModeHighQualityBicubic);
+    graphics.SetCompositingQuality(Gdiplus::CompositingQualityHighQuality);
+    graphics.DrawImage(image_.get(), left, top, draw_width, draw_height);
+    return true;
+  }
+
+ private:
+  std::unique_ptr<Gdiplus::Image> image_;
+};
+
+class StyledCheckBoxControl final : public DuiLib::CCheckBoxUI {
+ public:
+  [[nodiscard]] LPCTSTR GetClass() const override {
+    return L"StyledCheckBoxUI";
+  }
+
+  void SetAttribute(LPCTSTR name, LPCTSTR value) override {
+    if (_wcsicmp(name, L"checkcolor") == 0) {
+      check_color_ = ParseArgb(value, check_color_);
+    } else if (_wcsicmp(name, L"uncheckedbordercolor") == 0) {
+      unchecked_border_color_ = ParseArgb(value, unchecked_border_color_);
+    } else {
+      DuiLib::CCheckBoxUI::SetAttribute(name, value);
+    }
+  }
+
+  bool DoPaint(HDC dc,
+               const RECT& paint,
+               DuiLib::CControlUI* stop_control) override {
+    if (!DuiLib::CCheckBoxUI::DoPaint(dc, paint, stop_control)) {
+      return false;
+    }
+
+    const RECT bounds = GetPos();
+    const UINT dpi = m_pManager == nullptr
+                         ? 96
+                         : m_pManager->GetDPIObj()->GetScale();
+    const Gdiplus::REAL size = static_cast<Gdiplus::REAL>(MulDiv(18, dpi, 96));
+    const Gdiplus::REAL left = static_cast<Gdiplus::REAL>(bounds.left + MulDiv(1, dpi, 96));
+    const Gdiplus::REAL top = static_cast<Gdiplus::REAL>(bounds.top) +
+                              (bounds.bottom - bounds.top - size) / 2.0F;
+    const Gdiplus::REAL radius = size * 0.22F;
+
+    Gdiplus::Graphics graphics(dc);
+    graphics.SetSmoothingMode(Gdiplus::SmoothingModeAntiAlias);
+    Gdiplus::GraphicsPath box;
+    box.AddArc(left, top, radius * 2.0F, radius * 2.0F, 180.0F, 90.0F);
+    box.AddArc(left + size - radius * 2.0F, top, radius * 2.0F,
+               radius * 2.0F, 270.0F, 90.0F);
+    box.AddArc(left + size - radius * 2.0F, top + size - radius * 2.0F,
+               radius * 2.0F, radius * 2.0F, 0.0F, 90.0F);
+    box.AddArc(left, top + size - radius * 2.0F, radius * 2.0F,
+               radius * 2.0F, 90.0F, 90.0F);
+    box.CloseFigure();
+
+    const bool checked = GetCheck();
+    Gdiplus::SolidBrush fill{Gdiplus::Color(checked ? check_color_ : 0xFFFFFFFF)};
+    Gdiplus::Pen border(
+        Gdiplus::Color(checked ? check_color_ : unchecked_border_color_),
+        static_cast<Gdiplus::REAL>(MulDiv(1, dpi, 96)));
+    graphics.FillPath(&fill, &box);
+    graphics.DrawPath(&border, &box);
+
+    if (checked) {
+      Gdiplus::Pen tick(Gdiplus::Color(0xFFFFFFFF),
+                        (std::max)(1.5F, size * 0.11F));
+      tick.SetStartCap(Gdiplus::LineCapRound);
+      tick.SetEndCap(Gdiplus::LineCapRound);
+      Gdiplus::PointF points[] = {
+          {left + size * 0.24F, top + size * 0.51F},
+          {left + size * 0.43F, top + size * 0.69F},
+          {left + size * 0.77F, top + size * 0.32F}};
+      graphics.DrawLines(&tick, points, static_cast<INT>(std::size(points)));
+    }
+    return true;
+  }
+
+ private:
+  DWORD check_color_ = 0xFF111111;
+  DWORD unchecked_border_color_ = 0xFF8A929B;
+};
