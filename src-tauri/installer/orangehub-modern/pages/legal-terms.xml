<?xml version="1.0" encoding="UTF-8"?>
<Window size="{{window.width}},{{window.height}}" caption="0,0,0,47" roundcorner="{{window.radius}},{{window.radius}}" gdiplustext="true">
  <Font id="0" name="{{font.family}}" size="{{font.bodySize}}" default="true" />
  <Font id="1" name="Microsoft YaHei UI" size="24" bold="true" />
  <Font id="2" name="Microsoft YaHei UI" size="13" bold="true" />
  <Container name="page-root">
    <VerticalLayout float="0,0,1,1" bkcolor="{{color.canvas}}">
      <HorizontalLayout height="47" inset="19,9,17,9" childvalign="vcenter">
        <AppImage source="{{runtime.appIconPath}}" width="32" height="32" />
        <Label text="OrangeHub" font="2" textcolor="{{color.textPrimary}}" width="103" padding="8,0,0,0" />
        <Control />
        <CaptionButton name="minbtn" kind="minimize" iconcolor="{{color.textSecondary}}" hoticoncolor="{{color.textPrimary}}" hotbkcolor="{{color.surfaceMuted}}" pushedbkcolor="{{color.surfaceStrong}}" width="28" height="27" borderround="6,6" />
        <Control width="5" />
        <CaptionButton name="closebtn" kind="close" iconcolor="{{color.textSecondary}}" hoticoncolor="{{color.danger}}" hotbkcolor="{{color.surfaceMuted}}" pushedbkcolor="{{color.surfaceStrong}}" width="28" height="27" borderround="6,6" />
      </HorizontalLayout>
      <VerticalLayout inset="43,24,43,24">
        <HorizontalLayout height="33" childvalign="vcenter">
          <Button name="legal-back" text="{{string.legal.back}}" textcolor="{{color.textPrimary}}" hottextcolor="{{color.textPrimary}}" bkcolor="{{color.surfaceMuted}}" hotbkcolor="{{color.surfaceStrong}}" pushedbkcolor="{{color.surfaceStrong}}" width="104" height="28" borderround="6,6" />
          <Control />
        </HorizontalLayout>
        <Control height="14" />
        <Label text="{{string.legal.termsTitle}}" font="1" textcolor="{{color.textPrimary}}" height="36" />
        <Label text="{{string.legal.termsIntro}}" textcolor="{{color.textSecondary}}" valign="top" wordbreak="true" height="57" />
        <Control height="6" />
        <Label text="{{string.legal.termsLicenseTitle}}" font="2" textcolor="{{color.textPrimary}}" height="22" />
        <Label text="{{string.legal.termsLicenseBody}}" textcolor="{{color.textSecondary}}" valign="top" wordbreak="true" height="88" />
        <Control height="6" />
        <Label text="{{string.legal.termsUseTitle}}" font="2" textcolor="{{color.textPrimary}}" height="22" />
        <Label text="{{string.legal.termsUseBody}}" textcolor="{{color.textSecondary}}" valign="top" wordbreak="true" height="73" />
        <Control height="6" />
        <Label text="{{string.legal.termsThirdPartyTitle}}" font="2" textcolor="{{color.textPrimary}}" height="22" />
        <Label text="{{string.legal.termsThirdPartyBody}}" textcolor="{{color.textSecondary}}" valign="top" wordbreak="true" height="73" />
        <Control height="6" />
        <Label text="{{string.legal.termsDisclaimerTitle}}" font="2" textcolor="{{color.textPrimary}}" height="22" />
        <Label text="{{string.legal.termsDisclaimerBody}}" textcolor="{{color.textSecondary}}" valign="top" wordbreak="true" height="73" />
        <Control />
      </VerticalLayout>
    </VerticalLayout>
  </Container>
</Window>
