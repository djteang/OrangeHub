<?xml version="1.0" encoding="UTF-8"?>
<Window size="{{window.width}},{{window.height}}" caption="0,0,0,60" roundcorner="{{window.radius}},{{window.radius}}" gdiplustext="true">
  <Font id="0" name="{{font.family}}" size="{{font.bodySize}}" default="true" />
  <Font id="1" name="Microsoft YaHei UI" size="30" bold="true" />
  <Font id="2" name="Microsoft YaHei UI" size="17" bold="true" />
  <Container name="page-root">
    <VerticalLayout float="0,0,1,1" bkcolor="{{color.canvas}}">
      <HorizontalLayout height="60" inset="24,12,22,12" childvalign="vcenter">
        <AppImage source="{{runtime.appIconPath}}" width="40" height="40" />
        <Label text="OrangeHub" font="2" textcolor="{{color.textPrimary}}" width="130" padding="10,0,0,0" />
        <Control />
        <CaptionButton name="minbtn" kind="minimize" iconcolor="{{color.textSecondary}}" hoticoncolor="{{color.textPrimary}}" hotbkcolor="{{color.surfaceMuted}}" pushedbkcolor="{{color.surfaceStrong}}" width="36" height="34" borderround="8,8" />
        <Control width="6" />
        <CaptionButton name="closebtn" kind="close" iconcolor="{{color.textSecondary}}" hoticoncolor="{{color.danger}}" hotbkcolor="{{color.surfaceMuted}}" pushedbkcolor="{{color.surfaceStrong}}" width="36" height="34" borderround="8,8" />
      </HorizontalLayout>
      <VerticalLayout inset="54,30,54,30">
        <HorizontalLayout height="42" childvalign="vcenter">
          <Button name="legal-back" text="{{string.legal.back}}" textcolor="{{color.textPrimary}}" hottextcolor="{{color.textPrimary}}" bkcolor="{{color.surfaceMuted}}" hotbkcolor="{{color.surfaceStrong}}" pushedbkcolor="{{color.surfaceStrong}}" width="132" height="36" borderround="8,8" />
          <Control />
        </HorizontalLayout>
        <Control height="18" />
        <Label text="{{string.legal.termsTitle}}" font="1" textcolor="{{color.textPrimary}}" height="46" />
        <Label text="{{string.legal.termsIntro}}" textcolor="{{color.textSecondary}}" valign="top" wordbreak="true" height="72" />
        <Control height="8" />
        <Label text="{{string.legal.termsLicenseTitle}}" font="2" textcolor="{{color.textPrimary}}" height="28" />
        <Label text="{{string.legal.termsLicenseBody}}" textcolor="{{color.textSecondary}}" valign="top" wordbreak="true" height="112" />
        <Control height="8" />
        <Label text="{{string.legal.termsUseTitle}}" font="2" textcolor="{{color.textPrimary}}" height="28" />
        <Label text="{{string.legal.termsUseBody}}" textcolor="{{color.textSecondary}}" valign="top" wordbreak="true" height="92" />
        <Control height="8" />
        <Label text="{{string.legal.termsThirdPartyTitle}}" font="2" textcolor="{{color.textPrimary}}" height="28" />
        <Label text="{{string.legal.termsThirdPartyBody}}" textcolor="{{color.textSecondary}}" valign="top" wordbreak="true" height="92" />
        <Control height="8" />
        <Label text="{{string.legal.termsDisclaimerTitle}}" font="2" textcolor="{{color.textPrimary}}" height="28" />
        <Label text="{{string.legal.termsDisclaimerBody}}" textcolor="{{color.textSecondary}}" valign="top" wordbreak="true" height="92" />
        <Control />
      </VerticalLayout>
    </VerticalLayout>
  </Container>
</Window>
